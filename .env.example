# Copy this file to .env and fill in real values.
# .env is gitignored. Do not commit secrets.
# Loaded from this repo's .env (path relative to variables.py), not from cwd.
# Existing process environment wins (dotenv override=False), so /etc/environment
# still takes precedence when both define the same key.

# Telegram bot
SPOT_SEEK_BOT_API=
MUSIC_DATABASE_ID=
LOG_CHANNEL_ID=
BOT_NAME=Spot Seek Bot
BOT_USERNAME=@SpotSeekBot
DEVELOPER_CHANNEL_USERNAME=@your_channel
DEVELOPER_GITHUB_URL=https://github.com/yourname/your-repo
DEVELOPER_YOUTUBE_URL=
INSTAGRAM_DOWNLOADER_BOT_USERNAME=@your_instagram_bot
SUCCESS_MESSAGE_SPONSOR=@your_channel
PROMOTE_CHANNEL_USERNAME=@your_channel

# Warp SOCKS JSON object. May also be provided system-wide; leave /etc/environment
# in place if other projects use WARP_PROXIES.
WARP_PROXIES={"http": "******localhost:40001", "https": "******localhost:40001"}

# JSON list of [spotify_client_id, spotify_client_secret] pairs
SPOTIFY_APPS_LIST=[["client_id", "client_secret"]]

# JSON list of SOCKS URLs: "******host:port"
SOCKS_PROXIES=["******host:port"]

# S3 (unused; bucket deleted)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=

# SFTP (backup)
SFTP_HOST=
SFTP_PORT=23
SFTP_USERNAME=
SFTP_PASSWORD=

# Private Telegram archive channels (JSON object) and current inbox
CHANNEL_IDS={"sp1": 0, "sp2": 0}
SP11_CHANNEL_ID=

# Telegram webhook
WEBHOOK_HOST=https://your-domain.example.com
WEBHOOK_SECRET_TOKEN=

# Telethon backup (shared with other Storage projects via /etc/environment)
DEVELOPER_TELEGRAM_APP_API_ID=
DEVELOPER_TELEGRAM_APP_API_HASH=
DEVELOPER_TELEGRAM_PHONE_NUMBER=

# Absolute path to the private Git LFS clone that stores music.db snapshots
DB_BACKUP_REPO=
